//
// random(): numero in virgola mobile in [0, 1). Non deterministico
// (fuori dalla suite di conformità, come now()). Compila via crate `rand`.

fn main() {
    r = random()
    // r e' sempre >= 0 e < 1
    if r >= 0.0 {
        if r < 1.0 {
            print("ok")
        }
    }
    // lancio di un dado 1..6
    dado = int(random() * 6.0) + 1
    print(dado)
}
