//
// pow(base, esponente): potenza fra interi (esponente >= 0). Interprete e nativo.
//   python3 main.py       ../examples/native_pow.logyx
//   python3 main.py build ../examples/native_pow.logyx

fn main() {
    print("2^10 = {pow(2, 10)}")
    print("3^4  = {pow(3, 4)}")
    print("5^0  = {pow(5, 0)}")
}
