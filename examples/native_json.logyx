//
// to_json: serializzazione in JSON di scalari e record. Interprete e nativo.
//   python3 main.py       ../examples/native_json.logyx
//   python3 main.py build ../examples/native_json.logyx

record Persona {
    nome: string,
    eta: int
}

record Squadra {
    nome: string,
    capitano: Persona,
    attiva: bool
}

fn main() {
    ada = Persona("Ada", 36)
    print(to_json(ada))

    s = Squadra("Alfa", Persona("Guido", 45), true)
    print(to_json(s))

    print(to_json(42))
    print(to_json("con \"virgolette\" e \\ backslash"))

    // float e liste (v0: liste letterali o variabili lista)
    print(to_json(3.0))
    print(to_json(2.5))
    numeri = [1, 2, 3]
    print(to_json(numeri))
    reali = [1.5, 2.0, 3.25]
    print(to_json(reali))
    parole = ["alfa", "beta"]
    print(to_json(parole))
    squadra = [Persona("Ada", 36), Persona("Guido", 45)]
    print(to_json(squadra))

    // mappe (v0: chiavi string; chiavi ordinate per output deterministico)
    prezzi = {"pane": 2, "latte": 1, "uova": 3}
    print(to_json(prezzi))
    rosa = {"cap": Persona("Ada", 36), "vice": Persona("Guido", 45)}
    print(to_json(rosa))
}
