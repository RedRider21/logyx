//
// from_json: deserializza una stringa JSON in un record (usa la crate serde).
//   python3 main.py       ../examples/native_fromjson.logyx     (interprete, usa json)
//   python3 main.py build ../examples/native_fromjson.logyx     (nativo, usa serde)

record Punto {
    x: int,
    y: int
}

record Persona {
    nome: string,
    eta: int
}

fn main() {
    // nelle stringhe '{' '}' vanno escapati (avviano l'interpolazione): \{ \}
    testo = "\{\"x\":3,\"y\":7\}"
    p = from_json(testo, Punto)

    print("x = {p.x}, y = {p.y}")
    print(to_json(p))

    // lista di record: from_json(testo, [Record])
    elenco = "[\{\"nome\":\"Ada\",\"eta\":36\},\{\"nome\":\"Guido\",\"eta\":45\}]"
    gente = from_json(elenco, [Persona])
    print(len(gente))
    print(to_json(gente))

    // scalari e liste di scalari
    n = from_json("42", int)
    print(n + 1)
    nomi = from_json("[\"a\",\"b\",\"c\"]", [string])
    print(join(nomi, "-"))
    numeri = from_json("[1,2,3]", [int])
    print(sum(numeri))

    // mappa: from_json(testo, {string: tipo})
    prezzi = from_json("\{\"pane\":2,\"latte\":1\}", {string: int})
    print(has(prezzi, "pane"))
    print(to_json(prezzi))
}
