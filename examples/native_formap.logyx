// Iterazione diretta su una mappa: for k in mappa (chiavi ordinate, deterministico).

fn main() {
    prezzi = {"pane": 2, "latte": 1, "uova": 3}
    for k in prezzi {
        print(k + ": " + str(prezzi[k]))
    }
}
