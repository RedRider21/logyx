//
// Assegnazione a un elemento: xs[i] = v (lista) e m[k] = v (mappa).

fn main() {
    xs = [1, 2, 3]
    xs[1] = 20
    print(xs[0] + xs[1] + xs[2])   // 1 + 20 + 3 = 24

    m = {"a": 1}
    m["b"] = 2
    m["a"] = 10
    print(m["a"])                  // 10
    print(m["b"])                  // 2
}
