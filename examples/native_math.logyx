//
// Builtin matematici: abs, min, max. Interprete e nativo.
//   python3 main.py       ../examples/native_math.logyx
//   python3 main.py build ../examples/native_math.logyx

fn main() {
    print("abs(-7)   = {abs(-7)}")
    print("min(3, 8) = {min(3, 8)}")
    print("max(3, 8) = {max(3, 8)}")

    a = -5
    print("abs(a) + max(a, 2) = {abs(a) + max(a, 2)}")
}
