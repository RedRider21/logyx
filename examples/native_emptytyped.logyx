//
// Collezioni VUOTE con tipo annotato: `xs: [T] = []`, `m: {K: V} = {}`.
// Il tipo arriva dall'annotazione, così i backend tipizzati non devono dedurlo
// dagli elementi (che ancora non ci sono). Utile per accumulare risultati.

record Punto {
    x: int,
    y: int
}

fn main() {
    nums: [int] = []
    for i in range(1, 6) { push(nums, i * 10) }
    print("nums: {len(nums)} elementi, somma {sum(nums)}")     // 5, 150

    punti: [Punto] = []
    push(punti, Punto(1, 2))
    push(punti, Punto(3, 4))
    print("ultimo punto: {punti[1].x},{punti[1].y}")           // 3,4

    conta: {string: int} = {}
    for p in ["a", "b", "a", "c", "a"] {
        if has(conta, p) { conta[p] = conta[p] + 1 } else { conta[p] = 1 }
    }
    for k in conta { print("{k} = {conta[k]}") }                // a=3 b=1 c=1

    vuota: [string] = []
    print("vuota: {len(vuota)}")                                // 0
}
