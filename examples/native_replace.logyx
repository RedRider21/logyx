//
// replace(s, da, a): sostituisce tutte le occorrenze. Interprete e nativo.
//   python3 main.py       ../examples/native_replace.logyx
//   python3 main.py build ../examples/native_replace.logyx

fn main() {
    s = "ciao mondo mondo"
    da = "mondo"
    a = "terra"
    print("{replace(s, da, a)}")      // ciao terra terra
}
