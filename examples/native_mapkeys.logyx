//
// keys/values sulle mappe: chiavi ordinate (output deterministico).

fn main() {
    prezzi = {"pane": 2, "latte": 1, "uova": 3}
    print(join(keys(prezzi), ", "))
    print(sum(values(prezzi)))
    print(len(keys(prezzi)))
    print(has(prezzi, "pane"))
}
