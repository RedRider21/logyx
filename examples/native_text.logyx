// Builtin di testo: upper, lower. Interprete e nativo.
//   python3 main.py       ../examples/native_text.logyx
//   python3 main.py build ../examples/native_text.logyx

fn grida(testo) {
    return upper(testo)
}

fn main() {
    nome = "Logyx"
    print("maiuscolo: {upper(nome)}")
    print("minuscolo: {lower(nome)}")
    print(grida("ciao mondo"))
}
