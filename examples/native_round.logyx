// floor e ceil: arrotondamento verso il basso / verso l'alto (ritornano int).
//   python3 main.py       ../examples/native_round.logyx
//   python3 main.py build ../examples/native_round.logyx

fn main() {
    print("floor(2.7)  = {floor(2.7)}")     // 2
    print("ceil(2.1)   = {ceil(2.1)}")      // 3
    print("floor(-1.5) = {floor(-1.5)}")    // -2
    print("ceil(-1.5)  = {ceil(-1.5)}")     // -1
}
