//
// round(x): arrotonda all'intero più vicino, metà lontano dallo zero.

fn main() {
    print(round(2.4))     // 2
    print(round(2.5))     // 3  (metà -> lontano dallo zero)
    print(round(2.6))     // 3
    print(round(-2.5))    // -3
    print(round(0.5))     // 1
    print(round(1.0))     // 1
}
