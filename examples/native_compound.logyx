// Operatori composti: += -= *= /= %=. Interprete e nativo.
//   python3 main.py       ../examples/native_compound.logyx
//   python3 main.py build ../examples/native_compound.logyx

fn main() {
    x = 10
    x += 5
    x -= 3
    x *= 2
    print("x = {x}")        // (10 + 5 - 3) * 2 = 24

    acc = 0
    for i in range(1, 6) {
        acc += i
    }
    print("acc = {acc}")    // 1+2+3+4+5 = 15

    r = 20
    r %= 7
    print("r = {r}")        // 20 % 7 = 6
}
