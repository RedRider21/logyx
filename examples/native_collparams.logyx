// Liste e mappe come parametri e come tipo di ritorno delle funzioni.

fn somma(xs: [int]) -> int {
    tot = 0
    for x in xs { tot += x }
    return tot
}

fn raddoppia(xs: [int]) -> [int] {
    return map(xs, |x| x * 2)
}

fn chiavi_ordinate(m: {string: int}) -> [string] {
    return keys(m)
}

fn totale(m: {string: int}) -> int {
    t = 0
    for k in m { t += m[k] }
    return t
}

fn main() {
    nums = [1, 2, 3, 4]
    print(somma(nums))                  // 10
    for y in raddoppia(nums) { print(y) }   // 2 4 6 8

    prezzi = {"pane": 2, "latte": 1}
    for k in chiavi_ordinate(prezzi) { print(k) }   // latte pane
    print(totale(prezzi))               // 3
}
