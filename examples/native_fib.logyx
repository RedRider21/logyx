// Sottoinsieme tipizzato: questo file si compila a codice nativo via Rust.
//   python3 main.py build ../examples/native_fib.logyx

fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    for i in range(11) {
        print("fib({i}) = {fib(i)}")
    }
}
