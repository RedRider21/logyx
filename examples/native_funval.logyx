// Valori funzione: una funzione o una lambda passata a un parametro fn(...)->...

fn raddoppia(n: int) -> int {
    return n * 2
}

fn applica(g: fn(int) -> int, x: int) -> int {
    return g(x)
}

fn main() {
    print(applica(raddoppia, 5))
    print(applica(|y| y + 1, 5))
}
